{
    "name": "webbycrown/seo-kit-statamic",
    "version": "1.0.0",
    "description": "SEO kit for Statamic starter sites — meta, Open Graph, JSON-LD, and XML sitemap",
    "keywords": [
        "statamic",
        "addon",
        "seo",
        "sitemap",
        "json-ld",
        "open-graph"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "WebbyCrown",
            "homepage": "https://github.com/webbycrown/seo-kit-statamic"
        }
    ],
    "require": {
        "php": "^8.1",
        "statamic/cms": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "WebbyCrown\\SeoKitStatamic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebbyCrown\\SeoKitStatamic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebbyCrown\\SeoKitStatamic\\ServiceProvider"
            ]
        },
        "statamic": {
            "name": "SEO Kit",
            "description": "Meta, Open Graph, JSON-LD, and XML sitemap for Statamic starter kits"
        }
    }
}
